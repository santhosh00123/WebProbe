# WebProbe Environment Configuration

# Optional: LLM API Key (DeepSeek / OpenAI compatible endpoint)
# Leave empty to run in deterministic, offline rule-based payload mode
LLM_API_KEY=

# Base URL for the LLM API provider (Default: DeepSeek)
LLM_BASE_URL=https://api.deepseek.com/v1

# Model identifier
LLM_MODEL=deepseek-chat
